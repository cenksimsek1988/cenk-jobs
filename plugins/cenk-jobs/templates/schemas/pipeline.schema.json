{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PIPELINE: a sent job's hiring steps and outcome, by job id",
  "description": "Written only by track.py step and track.py outcome (recordlib.py); a hand edit skips the stale-base check. A step is known by its position (1, 2, ...): steps are added, never reordered or removed. An entry with same_as shares the steps and outcome of the entry it names. A missing entry or stage means pending. Its keys are closed, unlike the other schemas': two commands are its only writers, so a key they do not write is a hand edit for records.py check to name.",
  "type": "object",
  "properties": {
    "_about": {"type": "string"}
  },
  "additionalProperties": {"$ref": "#/$defs/entry"},
  "$defs": {
    "stage": {"enum": ["approved", "pending", "rejected", "closed", "declined"]},
    "why": {"description": "why the person declined or withdrew", "enum": ["ethics", "relocation", "pay", "other"]},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "a date, YYYY-MM-DD"},
    "day": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}", "description": "a date, YYYY-MM-DD[THH:MM]"},
    "entry": {
      "type": "object",
      "properties": {
        "stage": {"$ref": "#/$defs/stage"},
        "date": {"$ref": "#/$defs/day"},
        "reason": {"type": "string"},
        "mail": {"type": "string"},
        "why": {"$ref": "#/$defs/why"},
        "category": {"type": "string"},
        "same_as": {"type": "string"},
        "steps": {"type": "array", "items": {"$ref": "#/$defs/step"}},
        "rejected": {"type": "object", "description": "older rows: {date, reason} of a rejection"},
        "reminder": {"type": "string"},
        "history": {"type": "array", "description": "earlier stages and outcomes, each with until"}
      },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "date": {"$ref": "#/$defs/day"},
        "time": {"type": "string"},
        "due": {"$ref": "#/$defs/day"},
        "done": {"$ref": "#/$defs/date"},
        "cancelled": {"$ref": "#/$defs/date"},
        "proposed": {"type": "boolean"},
        "how": {"type": "string"},
        "with": {"type": "string"},
        "link": {"type": "string"},
        "mail": {"type": "string"},
        "note": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
