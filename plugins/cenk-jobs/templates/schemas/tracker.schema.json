{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TRACKER: the jobs, as {jobs: [...]} or the older {companies: [{name, jobs: [...]}]}",
  "description": "Read by recordlib.py (a write) and records.py check (the whole file). Phase 1 lists the keys whose type or vocabulary is checked; other keys stay allowed until the migration (phase 3) closes the shape. A key with spaces around it is a shape fault anywhere.",
  "type": "object",
  "properties": {
    "_about": {"type": "string"},
    "jobs": {"type": "array", "items": {"$ref": "#/$defs/job"}},
    "companies": {"type": "array", "items": {"$ref": "#/$defs/company"}}
  },
  "$defs": {
    "status": {
      "description": "A job's status before it is sent, and submitted; a sent job's outcome is its stage in PIPELINE.",
      "enum": ["found", "pending", "to-apply", "account-needed", "needs-person", "needs-captcha", "submitted",
               "skipped", "excluded", "failed", "closed", "declined"]
    },
    "waits_kind": {"enum": ["account", "captcha", "person", "essay", "answer"]},
    "todo_kind": {"enum": ["urgent", "working", "task", "click", "todo", "waiting"]},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "a date, YYYY-MM-DD"},
    "company": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "jobs": {"type": "array", "items": {"$ref": "#/$defs/job"}}
      }
    },
    "job": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"},
        "url": {"type": "string"},
        "apply_url": {"type": "string"},
        "status": {"$ref": "#/$defs/status"},
        "applied": {"type": "string", "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$",
                    "description": "a date, YYYY-MM-DD, or empty"},
        "waits_on": {"$ref": "#/$defs/waits_on"},
        "login": {"type": "string", "description": "older rows: the site a wait named, before waits_on"},
        "repeat_of": {"type": "string"},
        "todo": {"type": "array", "items": {"$ref": "#/$defs/todo"}},
        "history": {"type": "array"},
        "prep": {"type": "object"},
        "details": {"type": "string"}
      }
    },
    "waits_on": {
      "type": "object",
      "required": ["kind", "since"],
      "properties": {
        "kind": {"$ref": "#/$defs/waits_kind"},
        "login": {"type": "string"},
        "since": {"$ref": "#/$defs/date"}
      },
      "additionalProperties": false
    },
    "todo": {
      "type": "object",
      "properties": {
        "kind": {"$ref": "#/$defs/todo_kind"},
        "text": {"type": "string"},
        "since": {"$ref": "#/$defs/date"},
        "due": {"$ref": "#/$defs/date"},
        "where": {"enum": ["pc", "phone"]},
        "link": {"type": "string"},
        "login": {"type": "string"},
        "session": {"type": "string"}
      }
    }
  }
}
