# job-search.env - where this person's job search keeps everything.
# The cenk-jobs skills and their scripts are generic: they read every folder and file name from here.
# JOB_SEARCH_HOME is the main folder; the other paths are relative to it (forward slashes), unless absolute.
# Keep this file in the main folder. It holds names and paths only: never a password, token or ID number.

# --- the person ---------------------------------------------------------------------------------------------
PERSON_NAME={name}
# Name as printed at the top of CVs and letters.
NAME_ON_CV={name_upper}
# Contact line under the name on letters: city, phone, email, LinkedIn (never the home address).
CONTACT_LINE=
# Default headline under the name on letters (each letter can override it).
LETTER_TITLE=
# Accounts the connectors must be signed in to.
GMAIL_ACCOUNT=
CALENDAR_ACCOUNT=
DRIVE_ACCOUNT=

# --- folders ------------------------------------------------------------------------------------------------
JOB_SEARCH_HOME={home}
# Personal files the job search does not use (for example other people's CVs): never read for applications.
OTHER_FILES_DIR=
# Drop folder: the person puts all their documents here as they are; Claude sorts them into the folders below.
DOCUMENTS_INBOX_DIR=documents-inbox
RECORDS_DIR=career-records
CVS_DIR=CVs
CV_VERSIONS_DIR=CVs/versions
CERTIFICATES_DIR=certificates
DIPLOMAS_DIR=diplomas
PORTFOLIO_DIR=portfolio
APPLICATIONS_DIR=job-applications
LETTERS_DIR=apply/letters
LETTER_BODIES_DIR=apply/bodies

# --- files --------------------------------------------------------------------------------------------------
MASTER_RECORD=career-records/career.json
# CV photo (optional; leave empty for no photo).
PHOTO=photo.jpg
TRACKER=apply/targets.json
PIPELINE=apply/pipeline.json
# Login state (connectors and job-site sign-ins): written at each health check, read by the dashboard.
LOGINS=apply/logins.json
# Employer rules: the person's setting per category (never / ask / apply; a copy of the plugin's
# templates/employer-rules.json) and their own results per employer (employer.py).
EMPLOYER_RULES=career-records/employer-rules.json
EMPLOYER_CHECKS=apply/employer-checks.json
# Usage log (usage.py), and whether a weekly usage report may go to the plugin's developer: yes or no, asked once
# on the first run (empty = not asked yet). The report holds no personal data; the person sends each one.
USAGE_LOG=apply/usage-log.jsonl
USAGE_SHARING=
# Google Calendar category for job-search events: this color id (3 = Grape) and this title prefix.
CALENDAR_COLOR=3
CALENDAR_PREFIX=Job search ·
# Gmail label for a job-search message whose action is done (RULES.md, "Mail").
GMAIL_DONE_LABEL=cenk-jobs/Done
# Applications: auto (Claude sends each one whose answers all come from the records) or review (Claude stops at
# the review page and waits for the go-ahead). Default auto.
APPLY_MODE=auto
# Footer line on every CV (an EU data-processing consent by default; empty = no footer).
CV_FOOTER=I authorise the processing of my personal data in accordance with Regulation (EU) 2016/679 (GDPR) for recruitment purposes.

# --- optional, mostly for records kept before the plugin ------------------------------------------------------
# A JSON file with names and decisions the person's older records need (see templates/tracker-settings-example.json):
# CV nicknames used in notes, and for track.py sync the search files to merge, run labels and per-company decisions.
TRACKER_SETTINGS=
# Lines "<regex> => <replacement>": private text (a home address, an ID number typed into a form) replaced in every
# file build_app_folders.py writes. Keep this file outside shared folders (an absolute path is fine).
REDACT_FILE=
# CVs sent before the ones now in CVS_DIR: copied once into job-applications/_cv-versions, which older sent
# applications link. SENT_CVS_BEFORE_DIRS: ';'-separated folders with the copies that were really sent when a CV in
# SENT_CVS_DIR was changed later.
SENT_CVS_DIR=
SENT_CVS_BEFORE_DIRS=

# --- outside the folder -------------------------------------------------------------------------------------
# The dashboard: setup creates it and writes its link here; a run that finds none creates it again.
DASHBOARD_URL=
# The daily run time (local), set by /cenk-jobs:schedule.
SEARCH_TIME=19:00
# Leave empty to use the usual install paths.
CHROME=
PYTHON=
