# job-search.env - where this person's job search keeps everything.
# The cenk-jobs skills and their scripts are generic: they read every folder and file name from here.
# JOB_SEARCH_HOME is the main folder; the other paths are relative to it (forward slashes), unless absolute.
# Keep this file in the main folder. It holds names and paths only: never a password, token or ID number.

# --- the person ---------------------------------------------------------------------------------------------
PERSON_NAME={name}
# Name as printed at the top of CVs and letters.
NAME_ON_CV={name_upper}
# Contact line under the name on letters: city, phone, email, LinkedIn (never the home address).
CONTACT_LINE=
# Default headline under the name on letters (each letter can override it).
LETTER_TITLE=
# Accounts the connectors must be signed in to.
GMAIL_ACCOUNT=
CALENDAR_ACCOUNT=
DRIVE_ACCOUNT=

# --- folders ------------------------------------------------------------------------------------------------
JOB_SEARCH_HOME={home}
# Personal files the job search does not use (for example other people's CVs): never read for applications.
OTHER_FILES_DIR=
# Drop folder: the person puts all their documents here as they are; Claude sorts them into the folders below.
DOCUMENTS_INBOX_DIR=documents-inbox
RECORDS_DIR=career-records
CVS_DIR=CVs
CV_VERSIONS_DIR=CVs/versions
CERTIFICATES_DIR=certificates
DIPLOMAS_DIR=diplomas
PORTFOLIO_DIR=portfolio
APPLICATIONS_DIR=job-applications
LETTERS_DIR=apply/letters
LETTER_BODIES_DIR=apply/bodies
# Interview study notes: technical.md, screening.md, roadmap.md (references/study.md). Study only:
# never read for the master record, CVs, letters or forms. Unset: this default.
INTERVIEW_LESSONS_DIR=career-records/interview-lessons

# --- files --------------------------------------------------------------------------------------------------
MASTER_RECORD=career-records/career.json
# The person's profile (their own facts and settings) is not named here: the base plugin cenk-base finds it,
# cenk/profile.json in their Google Drive's "My Drive" folder or the folder CENK_HOME names (profilelib.py home).
# CV photo (optional; leave empty for no photo).
PHOTO=photo.jpg
TRACKER=apply/targets.json
PIPELINE=apply/pipeline.json
# Login state (connectors and job-site sign-ins): written at each health check, read by the dashboard.
LOGINS=apply/logins.json
# Questions for the person (questions.py): asked once on the Questions page, then written into the records.
QUESTIONS=apply/questions.json
# The open sessions and the order to answer them (sessions.py): kept by the main session, read by the dashboard.
SESSIONS=apply/sessions.json
# Saved searches (searches.py): one row per search, read from alert emails or checked on a schedule.
SEARCHES=apply/searches.json
# Variants: which model and effort each step uses, rotated over runs to compare their cost (variants.py; off
# until the file says "on": true).
VARIANTS=apply/variants.json
# Saved searches read by script (collect_postings.py): the title terms a search without its own uses (comma-separated;
# each matches whole words, so a phrase: "tech lead", not "lead"),
# the regions a remote posting must name to pass, and how many postings one run takes into the funnel.
ROLE_TERMS=
REMOTE_REGIONS=
# The places the person accepts on site or hybrid (cities and countries, comma-separated), used where a search names
# none, and the cities they ruled out, refused even inside an accepted country. Example: PLACES=Rome, Italy;
# NOT_PLACES=Turin.
PLACES=
NOT_PLACES=
# Their private pay figure per city (career_view.py pay), never shared.
PAY_TABLE=apply/pay-by-city.json
MAX_NEW_PER_RUN=30
# The person's title rules, applied before any text is read (regular expressions; templates/search-rules-example.json),
# and how many LinkedIn job texts one run reads to check that a remote search's posting is remote.
# The master record's preferences.locations.search_scope: its remote_regions stands for REMOTE_REGIONS and its
# any_mode_places for PLACES, each when present.
SEARCH_RULES=apply/search-rules.json
TEXT_FETCHES=40
# Postings whose own page is read for the location check before the funnel, per run.
LOCATION_CHECKS=60
# The fit score's settings (weights by place, grade bands, channel notes per place; templates/fit-settings-example.json),
# employer replies as fit clues (feedback.py) and the clues file the fit check reads, and where an unread
# posting's text is saved for the next fit check (fetch_jd.py --posting).
FIT_SETTINGS=apply/fit-settings.json
FEEDBACK_LOG=apply/reply-feedback.jsonl
FIT_CLUES=apply/fit-clues.md
POSTINGS_DIR=apply/postings
# Employer rules: the person's setting per category (exclude / discuss / allow; a copy of the plugin's
# templates/employer-rules.json) and their own results per employer (employer.py).
EMPLOYER_RULES=career-records/employer-rules.json
EMPLOYER_CHECKS=apply/employer-checks.json
# Per employer, the facts apart from the summary above (employer.py split): names.json and one folder each
# (default: "employers" beside EMPLOYER_CHECKS).
#EMPLOYERS_DIR=apply/employers
# Usage log (usage.py), and whether a weekly usage report may go to the plugin's developer: yes or no, asked once
# on the first run (empty = not asked yet). The report holds no personal data; the person sends each one.
USAGE_LOG=apply/usage-log.jsonl
USAGE_SHARING=
# Google Calendar category for job-search events: this color id (3 = Grape) and this title prefix.
CALENDAR_COLOR=3
CALENDAR_PREFIX=Job search ·
# Gmail label for a job-search message whose action is done (RULES.md, "Mail").
GMAIL_DONE_LABEL=cenk-jobs/Done
# The cost choices (choices.py; asked at setup with their token cost, changed by saying so): WRITER_MODEL opus|sonnet,
# EMPLOYER_CHECK cheap|free, APPLY auto|list, APPLY_FITS normal|high, LONG_SHOTS_PER_DAY (score 50-64, auto-sent a day; 0: none), LETTERS asked|always|never, ASK_FIRST the
# steps that wait for the person (send, free_text, interview; empty: all alone), CALENDAR auto|self, PLAN
# pro|max5|max20|other (it suggests the others, and cost.py table shows that plan's shares).
WRITER_MODEL=opus
EMPLOYER_CHECK=cheap
APPLY=auto
APPLY_FITS=normal
LONG_SHOTS_PER_DAY=0
LETTERS=asked
ASK_FIRST=send,free_text
CALENDAR=auto
PLAN=
# Form filling (choices.py): EMAILED_CODES off|on (on: the session reads an application's emailed code or
# confirmation link in Gmail and types it; sign-in codes stay the person's), OPTIONAL_FIELDS off|fill (fill:
# salutation, gender, demographics and EEO from the profile; off: blank, or "prefer not to say" where required).
EMAILED_CODES=off
OPTIONAL_FIELDS=off
# The plan's usage share for the run report, written by the opt-in status line script (statusline.py).
PLAN_USAGE=apply/plan-usage.json
# The status line's 7-day share, one row per change, for cost.py calibrate.
PLAN_USAGE_LOG=apply/plan-usage-log.jsonl
# The coordinator hands off to a fresh one past this context, in tokens (cost.py context).
COORDINATOR_CONTEXT=200000
# How many applications may fill at once, each a subagent with its own Chrome tab.
APPLY_PARALLEL=2
# Archive a session once its handoff is recorded: yes (no question), or empty (ask the person first).
ARCHIVE_SESSIONS=
# The model new sessions start with: sonnet, opus or haiku (empty: sonnet). The app
# starts a session with the main session's model or a cheaper one, never a higher one. Essays and study sessions
# always take the main session's model.
SESSION_MODEL=sonnet
# Footer line on every CV (an EU data-processing consent by default; empty = no footer).
CV_FOOTER=I authorise the processing of my personal data in accordance with Regulation (EU) 2016/679 (GDPR) for recruitment purposes.

# --- optional, mostly for records kept before the plugin ------------------------------------------------------
# A JSON file with names and decisions the person's older records need (see templates/tracker-settings-example.json):
# CV nicknames used in notes, and for track.py sync the search files to merge, run labels and per-company decisions.
TRACKER_SETTINGS=
# Lines "<regex> => <replacement>": private text (a home address, an ID number typed into a form) replaced in every
# file build_app_folders.py writes. Keep this file outside shared folders (an absolute path is fine).
REDACT_FILE=
# CVs sent before the ones now in CVS_DIR: copied once into job-applications/_cv-versions, which older sent
# applications link. SENT_CVS_BEFORE_DIRS: ';'-separated folders with the copies that were really sent when a CV in
# SENT_CVS_DIR was changed later.
SENT_CVS_DIR=
SENT_CVS_BEFORE_DIRS=

# --- outside the folder -------------------------------------------------------------------------------------
# The dashboard: setup creates it and writes its link here; a run that finds none creates it again.
DASHBOARD_URL=
# The Questions page (an artifact of its own): the person answers there what the applications need; setup
# creates it and writes its link here.
QUESTIONS_PAGE=
# The scheduled run's time (local) and days, set by /cenk-jobs:schedule from the task's real schedule.
# SEARCH_DAYS: weekdays (Monday to Friday, the default), daily, none (no task), or the days as text ("Mon, Wed").
SEARCH_TIME=19:00
SEARCH_DAYS=weekdays
# Where the cheat-sheet page sits on the screen: top, bottom, left, right or corner (written by cheat_sheet.py).
CHEAT_SHEET_SPOT=
# The monitor that holds the call (its number in cheat_sheet.py --monitors): the page opens on another one.
CALL_MONITOR=
# The Chrome profile the job search uses (its name as Chrome shows it); empty: the only or default profile.
CHROME_PROFILE=
# Leave empty to use the usual install paths.
CHROME=
PYTHON=
